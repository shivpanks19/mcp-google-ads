# Google Ads MCP Environment Configuration
# Copy this file to .env and fill in your actual values

# Authentication Type (choose one: "oauth" or "service_account")
# Use service_account for Render / Railway / Docker / CI (no browser). Invite the service account
# email in Google Ads: Tools & Settings > Access and security > Users.
GOOGLE_ADS_AUTH_TYPE=oauth

# Credentials: set ONE of JSON (recommended for Render/Railway) OR file path
# --- Service account (Render / Railway / headless) ---
# 1) Set GOOGLE_ADS_AUTH_TYPE=service_account
# 2) In Render Environment, add GOOGLE_ADS_CREDENTIALS_JSON = entire key JSON on ONE line (Secret)
#    (from Google Cloud: IAM > Service accounts > Keys > Add JSON). Must include "type":"service_account".
# 3) Unset or leave empty GOOGLE_ADS_CREDENTIALS_PATH if you only use JSON.
# 4) GOOGLE_ADS_IMPERSONATION_EMAIL only if you use domain-wide delegation / with_subject (rare for Ads).
#
# --- OAuth (local desktop only) ---
# GOOGLE_ADS_CREDENTIALS_JSON can be OAuth client or saved user token JSON; or use PATH to those files.
GOOGLE_ADS_CREDENTIALS_JSON=
GOOGLE_ADS_CREDENTIALS_PATH=/path/to/credentials.json

# Google Ads Developer Token (required)
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here

# HTTP timeout (seconds) for GAQL googleAds:search and similar requests; default 120.
# GOOGLE_ADS_REQUEST_TIMEOUT=120

# Manager Account ID (optional, for MCC accounts)
# Format: XXX-XXX-XXXX or XXXXXXXXXX
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# For OAuth-specific config (required if using OAuth and there's no client_secret.json)
GOOGLE_ADS_CLIENT_ID=your_client_id_here
GOOGLE_ADS_CLIENT_SECRET=your_client_secret_here

# For Service Account-specific config (optional)
# Email to impersonate with the service account (typically your admin email)
GOOGLE_ADS_IMPERSONATION_EMAIL=

# --- Render (Web Service) ---
# Do not commit .env. Set these in Render Dashboard → Environment (Secrets).
# Build: pip install -r requirements.txt
# Start:  python main.py
# Health: /health   MCP: /mcp   (PORT is set automatically by Render)
# See docs/render-deploy.md for full steps.

# Supabase (optional — AI memory and report snapshots)
# Create a project at https://supabase.com, run supabase/migrations/001_initial.sql and
# 002_analysis_text_snapshots.sql (for narrative analysis tools), then copy Project URL and
# service_role key from Settings → API.
# Use service_role only on the server (Railway / local MCP), never in client apps.
# Must be the **service_role** key (same page as anon); if inserts fail with RLS / 42501, you likely
# pasted the anon or publishable key instead.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_here

# Optional: set to 1 to auto-persist get_campaign_performance to report_snapshots without passing persist_snapshot each time.
# AUTO_PERSIST_CAMPAIGN_PERFORMANCE_SNAPSHOTS=1

# Optional: default lookback (days) for scripts/sync_campaign_performance_to_supabase.py when --days and --preset are omitted.
# SYNC_CAMPAIGN_PERFORMANCE_DAYS=14